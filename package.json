{
  "name": "hexo-site",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "prebuild": "npm run export:ai",
    "build": "hexo generate",
    "clean": "hexo clean",
    "deploy": "hexo deploy",
    "server": "hexo server",
    "export:ai": "node scripts/export-ai-documents.js",
    "test:ai": "npm --prefix blog-ai-api test",
    "eval:ai": "npm --prefix blog-ai-api run eval:bm25",
    "eval:agent": "npm --prefix blog-ai-api run eval:agent",
    "eval:hybrid": "npm --prefix blog-ai-api run eval:hybrid",
    "eval:phase4": "npm --prefix blog-ai-api run eval:phase4 --",
    "eval:phase4:update": "npm --prefix blog-ai-api run eval:phase4:update --",
    "eval:phase5": "npm --prefix blog-ai-api run eval:phase5 --"
  },
  "hexo": {
    "version": "7.3.0"
  },
  "dependencies": {
    "hexo": "^7.3.0",
    "hexo-asset-image": "github:CodeFalling/hexo-asset-image",
    "hexo-deployer-git": "^4.0.0",
    "hexo-generator-archive": "^2.0.0",
    "hexo-generator-category": "^2.0.0",
    "hexo-generator-feed": "^4.0.0",
    "hexo-generator-index": "^4.0.0",
    "hexo-generator-searchdb": "^1.5.0",
    "hexo-generator-sitemap": "^3.0.1",
    "hexo-generator-tag": "^2.0.0",
    "hexo-renderer-ejs": "^2.0.0",
    "hexo-renderer-markdown-it": "^7.1.1",
    "hexo-renderer-nunjucks": "^2.0.0",
    "hexo-renderer-stylus": "^3.0.1",
    "hexo-server": "^3.0.0",
    "hexo-theme-landscape": "^1.0.0",
    "markdown-it": "^13.0.1",
    "save": "^2.9.0"
  }
}
