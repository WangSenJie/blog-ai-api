{
  "name": "blog-ai-api",
  "version": "0.0.0",
  "private": true,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "sync:corpus": "node scripts/sync-corpus.js",
    "test": "node --test",
    "eval:bm25": "node evals/run.js",
