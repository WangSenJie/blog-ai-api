{
  "version": 1,
  "strategy": "structured_agentic_rag_phase5",
  "description": "阶段 5 真实语料验收集。它验证有结构的多文章对比、作者维护学习图谱、原始代码块定位，以及缺少站内依据时的专用安全拒答。所有事实性输出都必须回到当前服务语料中的可验证引用；学习路线只允许使用作者维护的导航元数据。",
  "cases": [
    {
      "id": "compare-itemcf-usercf-aligned",
      "category": "comparison",
      "question": "比较 ItemCF 和 UserCF 的实现和流程",
      "expected": {
        "answerability": "factual",
        "route": "article_compare",
        "toolNames": ["compare_articles"],
        "citationTitles": ["ItemCF", "UserCF"],
        "comparison": {
          "articleTitles": ["ItemCF", "UserCF"],
          "rowIds": ["core", "implementation", "workflow"]
        }
      }
    },
    {
      "id": "learning-mathematical-analysis-author-order",
      "category": "learning_path",
      "question": "给我数学分析的学习路径",
      "expected": {
        "answerability": "navigation",
        "route": "learning_path",
        "toolNames": ["recommend_learning_path"],
        "learning": {
          "trackId": "mathematical-analysis",
          "kind": "path",
          "stepIds": [
            "analysis-limits",
            "analysis-continuity",
            "analysis-completeness",
            "analysis-differentiation",
            "analysis-integration",
            "analysis-number-series",
            "analysis-function-series"
          ],
          "relations": ["start", "next", "next", "next", "next", "next", "next"]
        }
      }
    },
    {
      "id": "learning-vue-prerequisite-order",
      "category": "learning_path",
      "question": "我想学习 Vue，应该先看什么？",
      "expected": {
        "answerability": "navigation",
        "route": "learning_path",
        "toolNames": ["recommend_learning_path"],
