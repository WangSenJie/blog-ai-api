body
  background linear-gradient(180deg, #eef6f8 0%, #f7fafb 46%, #e8eef2 100%)
  color #24303d

body::before,
body::after
  content ''
  pointer-events none
  position fixed
  inset 0
  z-index 0

body::before
  background linear-gradient(180deg, $site-bg-overlay 0%, rgba(235, 241, 244, .94) 100%), repeating-linear-gradient(90deg, rgba(20, 42, 68, .045) 0, rgba(20, 42, 68, .045) 1px, transparent 1px, transparent 88px), repeating-linear-gradient(0deg, rgba(20, 42, 68, .035) 0, rgba(20, 42, 68, .035) 1px, transparent 1px, transparent 88px)
  z-index 0

body::after
  background-image $site-bg-image
  background-position center top
  background-repeat no-repeat
  background-size cover
  opacity $site-bg-opacity
  transform scale(1.02)
  z-index 1

.container::before,
.container::after
  content ''
  pointer-events none
  position fixed
  z-index 0

.container::before
  top -120px
  right -90px
  width 560px
  height 720px
  background linear-gradient(135deg, rgba(26, 166, 168, .18), rgba(26, 166, 168, 0) 58%)
  clip-path polygon(32% 0, 100% 0, 74% 100%, 0 72%)

.container::after
  left -120px
  top 180px
  width 520px
  height 620px
  background linear-gradient(150deg, rgba(31, 42, 68, .1), rgba(31, 42, 68, 0) 64%)
  clip-path polygon(0 8%, 72% 0, 100% 72%, 18% 100%)

.container
  position relative
  z-index 2

.headband
  box-shadow 0 8px 24px rgba(15, 23, 42, .16)

.header-inner
  padding-top 40px

  +mobile()
    padding-top 28px

.site-brand-container
  background transparent
  border none
  border-radius 0
  box-shadow none
  backdrop-filter none
  overflow visible
  padding 34px 40px
  position relative

  &::before
    display none

  &::after
    display none

  +mobile()
    padding 22px 18px 16px

.brand
  background transparent !important
  box-shadow none
  align-items center
  display inline-flex
  gap 18px
  padding 0

  +mobile()
    gap 0

.logo-line-before,
.logo-line-after
  background linear-gradient(90deg, rgba(169, 199, 221, 0), rgba(169, 199, 221, .96), rgba(169, 199, 221, 0))
  display block
  height 1px
  width 92px

  i
    display none

  +mobile()
    display none

.site-title
  color #203040
  font-size 3rem
  font-weight 600
  letter-spacing .02em
  text-shadow none

  +mobile()
    font-size 2.05rem

.site-subtitle
  color rgba(39, 58, 75, .72)
  font-size .82rem
  letter-spacing .16em
  margin-top 16px
  text-transform uppercase

.site-nav
  background transparent
  border-radius 0
  overflow visible
  padding 0
  position relative

  &::before
    display none

  &::after
    display none

.main-menu
  align-items center
  display flex
  flex-wrap wrap
  gap 10px
  justify-content center
  margin 26px 0 2px
  padding 0

  +mobile()
    gap 8px
    margin-top 14px

.main-menu .menu-item
  margin 0

.main-menu .menu-item a
  background rgba(255, 255, 255, .42)
  border none
  border-radius 999px
  box-shadow inset 0 0 0 1px rgba(255, 255, 255, .58), 0 8px 18px rgba(15, 23, 42, .04)
  color #243447
  font-weight 600
  padding 10px 18px
  position relative
  transition background .2s ease, box-shadow .2s ease, color .2s ease
  z-index 2

  &:hover
    background rgba(255, 255, 255, .66)
    box-shadow inset 0 0 0 1px rgba(26, 166, 168, .32), 0 12px 24px rgba(15, 23, 42, .07)
    color #178f92

.menu-item-active a
  background rgba(255, 255, 255, .72)
  box-shadow inset 0 0 0 1px rgba(26, 166, 168, .34), 0 12px 24px rgba(15, 23, 42, .06)
  color #203040 !important

.site-nav-right .toggle
  background rgba(255, 255, 255, .56)
  border-radius 50%
  box-shadow inset 0 0 0 1px rgba(26, 166, 168, .24), 0 8px 18px rgba(15, 23, 42, .05)
  color #243447
  display grid
  height 42px
  place-items center
  width 42px

.content
  padding-top 42px

  +mobile()
    padding-top 22px

.home-hero
  background linear-gradient(135deg, rgba(248, 252, 253, .82), rgba(224, 240, 244, .48))
  border 1px solid rgba(255, 255, 255, .62)
  border-radius 8px
  box-shadow 0 24px 60px rgba(15, 23, 42, .1)
  display grid
  grid-template-columns minmax(0, 1.05fr) minmax(260px, .7fr)
  gap 28px
  min-height 430px
  overflow hidden
  padding 48px 48px 42px
  position relative
  backdrop-filter blur(18px)

  &::before
    background linear-gradient(90deg, rgba(26, 166, 168, .85), rgba(31, 42, 68, .05))
    content ''
    height 2px
    left 0
    position absolute
    right 0
    top 0

  &::after
    background linear-gradient(90deg, rgba(20, 42, 68, .08) 0, rgba(20, 42, 68, .08) 1px, transparent 1px, transparent 100%), linear-gradient(180deg, rgba(20, 42, 68, .06) 0, rgba(20, 42, 68, .06) 1px, transparent 1px, transparent 100%)
    background-size 42px 42px
    content ''
    inset 0
    opacity .42
    pointer-events none
    position absolute

.home-hero__content,
.home-hero__visual
  position relative
  z-index 1

.home-hero__kicker
  color #178f92
  font-size .78rem
  font-weight 800
  letter-spacing .18em
  margin 0 0 18px
  text-transform uppercase

.home-hero__title
  color #172536
  font-size 4.1rem
  font-weight 700
  line-height 1
  margin 0

.home-hero__summary
  color rgba(36, 52, 71, .78)
  font-size 1.08rem
  line-height 1.9
  margin 24px 0 0
  max-width 580px

.home-hero__topics
  display grid
  gap 12px
  grid-template-columns repeat(3, minmax(0, 1fr))
  margin-top 34px

  a
    background rgba(255, 255, 255, .44)
    border 1px solid rgba(255, 255, 255, .64)
    border-radius 8px
    box-shadow inset 0 1px 0 rgba(255, 255, 255, .68)
    color #243447
    display grid
    gap 3px
    min-height 78px
    padding 16px 14px
    text-decoration none
    transition border-color .2s ease, box-shadow .2s ease, transform .2s ease

    span
      color rgba(36, 52, 71, .56)
      font-size .68rem
      font-weight 800
      letter-spacing .08em
      text-transform uppercase

    strong
      color #172536
      font-size 1rem
      font-weight 700

    &:hover
      border-color rgba(26, 166, 168, .42)
      box-shadow inset 0 1px 0 rgba(255, 255, 255, .78), 0 12px 24px rgba(15, 23, 42, .08)
      color #178f92
      transform translateY(-2px)

.home-hero__actions
  display flex
  flex-wrap wrap
  gap 12px
  margin-top 28px

.home-hero__action
  align-items center
  background rgba(255, 255, 255, .48)
  border 1px solid rgba(255, 255, 255, .68)
  border-radius 999px
  color #243447
  display inline-flex
  font-weight 700
  min-height 42px
  padding 0 18px
  text-decoration none
  transition background .2s ease, border-color .2s ease, color .2s ease, transform .2s ease

  &:hover
    background rgba(255, 255, 255, .72)
    border-color rgba(26, 166, 168, .42)
    color #178f92
    transform translateY(-1px)

.home-hero__action--primary
  background linear-gradient(135deg, #1f2a44, #178f92)
  border-color rgba(255, 255, 255, .36)
  color #f8fcfd
  box-shadow 0 16px 34px rgba(23, 143, 146, .18)

  &:hover
    background linear-gradient(135deg, #172536, #1aa6a8)
    color #fff

.home-hero__visual
  align-self stretch
  min-height 300px

.home-hero__matrix
  background linear-gradient(135deg, rgba(31, 42, 68, .86), rgba(23, 143, 146, .58))
  border 1px solid rgba(255, 255, 255, .44)
  border-radius 8px
  box-shadow 0 24px 60px rgba(15, 23, 42, .16)
  inset 8px 0 8px auto
  overflow hidden
  position absolute
  max-width 100%
  width 330px

  &::before
    background linear-gradient(90deg, rgba(255, 255, 255, .11) 0, rgba(255, 255, 255, .11) 1px, transparent 1px, transparent 100%), linear-gradient(180deg, rgba(255, 255, 255, .1) 0, rgba(255, 255, 255, .1) 1px, transparent 1px, transparent 100%)
    background-size 28px 28px
    content ''
    inset 0
    opacity .62
    position absolute

  &::after
    color rgba(255, 255, 255, .72)
    content '∫  ∇  Σ  λ  AI  ML  01'
    font-family "SFMono-Regular", "Menlo", "Monaco", monospace
    font-size .78rem
    font-weight 700
    left 24px
    letter-spacing .12em
    position absolute
    right 24px
    top 24px
    word-spacing .4em

.home-hero__beam
  background linear-gradient(180deg, rgba(255, 255, 255, .72), rgba(26, 166, 168, .18), rgba(255, 255, 255, 0))
  height 74%
  position absolute
  right 46px
  top 13%
  transform skewX(-16deg)
  width 2px
  z-index 2

.home-hero__scanline
  background linear-gradient(90deg, transparent, rgba(255, 255, 255, .78), transparent)
  height 1px
  left 26px
  position absolute
  right 26px
  top 38%
  z-index 3
  animation homeScan 4.8s ease-in-out infinite

.home-section-label
  align-items end
  display flex
  justify-content space-between
  margin 34px 4px 16px

  span
    color #178f92
    font-size .72rem
    font-weight 800
    letter-spacing .18em
    text-transform uppercase

  strong
    color #172536
    font-size 1.1rem
    letter-spacing .04em

@keyframes homeScan
  0%, 100%
    opacity .28
    transform translateY(-92px)

  50%
    opacity .86
    transform translateY(124px)

@media (prefers-reduced-motion: reduce)
  .home-hero__scanline,
  .index .post-block,
  .home-hero__topics a,
  .home-hero__action
    animation none
    transition none

+tablet-mobile()
  .home-hero
    grid-template-columns 1fr
    min-height 0
    padding 36px 28px 30px

  .home-hero__visual
    min-height 180px

  .home-hero__matrix
    inset 0
    width 100%

  .home-hero__beam
    right 34px

  .home-hero__topics
    grid-template-columns 1fr

+mobile()
  body::after
    background-position 56% top
    opacity .28

  .home-hero
    padding 28px 20px 22px

  .home-hero__kicker
    font-size .68rem
    letter-spacing .12em

  .home-hero__title
    font-size 2.5rem

  .home-hero__summary
    font-size .98rem
    line-height 1.75

  .home-hero__visual
    display none

  .home-hero__topics
    gap 10px
    margin-top 24px

  .home-hero__topics a
    min-height 68px
    padding 14px

  .home-section-label
    align-items flex-start
    flex-direction column
    gap 4px
    margin 26px 2px 14px

.post-block,
.pagination,
.comments
  background rgba(255, 255, 255, .58)
  border 1px solid rgba(255, 255, 255, .62)
  border-radius 8px
  box-shadow 0 18px 40px rgba(15, 23, 42, .07)
  backdrop-filter blur(16px)
  overflow hidden
  padding 38px 42px

  +tablet-mobile()
    border-radius 8px
    padding 24px 20px

.posts-expand .post-block + .post-block
  margin-top 24px

.index .post-block
  position relative
  transition border-color .25s ease, box-shadow .25s ease, transform .25s ease

  &::before
    background linear-gradient(180deg, rgba(26, 166, 168, .74), rgba(26, 166, 168, 0))
    content ''
    inset 0 auto 0 0
    position absolute
    width 3px

  &:hover
    border-color rgba(26, 166, 168, .32)
    box-shadow 0 26px 52px rgba(15, 23, 42, .1)
    transform translateY(-3px)

.posts-expand .post-title
  color #151922
  font-size 2rem
  line-height 1.28

  +mobile()
    font-size 1.6rem

.index .post-title
  text-align left
  font-size 2rem

.index .post-meta
  text-align left

.posts-expand .post-title-link
  color #151922

  &::before
    background linear-gradient(90deg, #1aa6a8, #1f2a44)
    border-radius 999px
    height 2px

.posts-expand .post-meta
  color #6b7280
  letter-spacing .02em
  margin 10px 0 24px

.index .post-body
  font-size 1.04rem

.index .post-body h1
  display none

.index .post-body h2
  font-size 1.36rem
  margin-top 1.35em

.post-meta time
  border-bottom 1px dashed rgba(107, 114, 128, .35)

.post-button .btn
  background linear-gradient(135deg, #1f2a44, #178f92)
  border none
  box-shadow 0 12px 24px rgba(23, 143, 146, .18)
  color #f8fcfd
  padding 10px 20px

  &:hover
    background linear-gradient(135deg, #172536, #1aa6a8)
    color #fff

#blog-ai-agent-root
  position fixed
  right 24px
  bottom 28px
  z-index 40

  +mobile()
    right 14px
    bottom 18px

.blog-ai-agent__toggle
  background linear-gradient(135deg, #1f2a44, #178f92)
  border none
  border-radius 999px
  box-shadow 0 18px 36px rgba(23, 143, 146, .22)
  color #f8fbff
  cursor pointer
  font-size .95rem
  font-weight 600
  letter-spacing .02em
  padding 14px 18px

.blog-ai-agent__panel
  background rgba(250, 253, 254, .94)
  border 1px solid rgba(255, 255, 255, .72)
  border-radius 8px
  box-shadow 0 26px 60px rgba(15, 23, 42, .14)
  display none
  margin-top 14px
  max-width 92vw
  overflow hidden
  width 420px

  &.is-open
    display block

  +mobile()
    width 92vw

.blog-ai-agent__header
  align-items flex-start
  background linear-gradient(135deg, rgba(31, 42, 68, .94), rgba(23, 143, 146, .82))
  border-bottom 1px solid rgba(255, 255, 255, .28)
  display flex
  justify-content space-between
  gap 12px
  padding 18px 18px 14px

  h3
    color #f8fcfd
    font-size 1rem
    margin 0

  p
    color rgba(248, 252, 253, .72)
    font-size .8rem
    line-height 1.45
    margin 6px 0 0

.blog-ai-agent__close
  background transparent
  border none
  color rgba(248, 252, 253, .82)
  cursor pointer
  font-size 1.4rem
  line-height 1
  padding 2px 4px

.blog-ai-agent__suggestions
  display flex
  flex-wrap wrap
  gap 8px
  padding 14px 18px 0

  button
    background rgba(238, 248, 249, .92)
    border 1px solid rgba(23, 143, 146, .18)
    border-radius 999px
    color #243447
    cursor pointer
    font-size .8rem
    padding 8px 12px

.blog-ai-agent__messages
  max-height 360px
  overflow auto
  padding 14px 18px

.blog-ai-agent__message
  border-radius 8px
  margin-bottom 12px
  padding 12px 14px

.blog-ai-agent__message--assistant
  background #f5fafb
  border 1px solid rgba(205, 226, 230, .92)

.blog-ai-agent__message--user
  background linear-gradient(135deg, #1f2a44, #178f92)
  color #f8fbff
  margin-left 24px

.blog-ai-agent__message-label
  font-size .74rem
  font-weight 700
  letter-spacing .05em
  margin-bottom 6px
  opacity .72
  text-transform uppercase

.blog-ai-agent__message-body
  font-size .92rem
  line-height 1.65
  white-space pre-wrap
  word-break break-word

.blog-ai-agent__citation-list
  display grid
  gap 8px
  margin-top 12px

.blog-ai-agent__citation
  background rgba(255, 255, 255, .9)
  border 1px solid rgba(205, 226, 230, .95)
  border-radius 8px
  color #334155
  display block
  padding 10px 12px
  text-decoration none

  strong
    display block
    font-size .84rem
    margin-bottom 4px

  span
    color #607080
    display block
    font-size .78rem
    line-height 1.5

.blog-ai-agent__related
  display flex
  flex-wrap wrap
  gap 8px
  margin-top 12px

.blog-ai-agent__related-link
  background #eef8f9
  border-radius 999px
  color #178f92
  font-size .78rem
  padding 6px 10px
  text-decoration none

.blog-ai-agent__form
  border-top 1px solid rgba(214, 223, 232, .9)
  display grid
  gap 10px
  padding 14px 18px 18px

.blog-ai-agent__input
  background #fbfdff
  border 1px solid rgba(205, 226, 230, .95)
  border-radius 8px
  color #22303a
  font-size .92rem
  line-height 1.5
  min-height 92px
  padding 12px 14px
  resize vertical
  width 100%

.blog-ai-agent__submit
  background linear-gradient(135deg, #1f2a44, #178f92)
  border none
  border-radius 999px
  color #f8fbff
  cursor pointer
  font-weight 600
  justify-self end
  padding 10px 18px

  &:disabled
    cursor wait
    opacity .72

  &:hover
    background linear-gradient(135deg, #172536, #1aa6a8)
    color #fff

.post-body
  color #2f3742
  font-size 1.02rem
  line-height 1.98

  a,
  span.exturl
    border-bottom-color rgba(23, 143, 146, .28)
    color #178f92

    &:hover
      border-bottom-color rgba(17, 24, 39, .28)
      color #46545b

  h1,
  h2,
  h3,
  h4
    color #171b23
    margin-top 2em

  h2
    border-bottom 1px solid rgba(214, 220, 228, .95)
    padding-bottom .45em

  blockquote
    background rgba(244, 248, 247, .98)
    border-left 3px solid #1aa6a8
    border-radius 8px
    margin 26px 0
    padding 16px 20px

  img,
  iframe,
  video
    border-radius 8px
    box-shadow 0 14px 28px rgba(15, 23, 42, .08)

  code
    background rgba(15, 23, 42, .05)
    border-radius 6px
    color #178f92
    padding .15em .4em

.post-body > pre
  background linear-gradient(180deg, #fbfbfd 0%, #f5f5f7 100%)
  border 1px solid rgba(17, 24, 39, .08)
  border-radius 8px
  box-shadow 0 8px 24px rgba(15, 23, 42, .05), inset 0 1px 0 rgba(255, 255, 255, .9)
  margin 26px 0
  overflow hidden

.post-cover
  margin 0 0 24px
  overflow hidden
  position relative

  img
    aspect-ratio 16 / 8.8
    border-radius 8px
    display block
    object-fit cover
    width 100%
    box-shadow 0 18px 40px rgba(15, 23, 42, .08)

.index .post-cover
  margin-bottom 18px

  img
    aspect-ratio 16 / 8

.post-body > .post-cover:first-child
  margin-top 2px

.post-body figure.highlight
  background transparent
  border 0
  border-radius 0
  box-shadow none
  margin 0
  overflow visible

.post-body > pre
  padding 16px 18px

.post-body pre,
.post-body code
  font-family "SFMono-Regular", "SF Mono", "Menlo", "Monaco", "Consolas", monospace

.post-body code
  background rgba(255, 255, 255, .92)
  border 1px solid rgba(17, 24, 39, .05)
  border-radius 7px
  color #374151
  padding .18em .46em

.highlight-container
  background linear-gradient(180deg, rgba(255, 255, 255, .34) 0%, rgba(244, 247, 250, .24) 100%)
  border 1px solid rgba(255, 255, 255, .42)
  border-radius 8px
  box-shadow 0 18px 38px rgba(15, 23, 42, .08), inset 0 1px 0 rgba(255, 255, 255, .42)
  backdrop-filter blur(22px)
  margin 26px 0
  overflow hidden
  padding-top 44px
  position relative

  &::before
    background #ff5f57
    border-radius 50%
    box-shadow 16px 0 0 #febc2e, 32px 0 0 #28c840
    content ''
    height 9px
    left 16px
    position absolute
    top 17px
    width 9px
    z-index 2

  &::after
    background linear-gradient(180deg, rgba(255, 255, 255, .26), rgba(255, 255, 255, .1))
    border-bottom 1px solid rgba(255, 255, 255, .3)
    content ''
    backdrop-filter blur(18px)
    height 44px
    inset 0 0 auto 0
    position absolute

.highlight-container .highlight
  background transparent
  border 0
  border-radius 0 0 8px 8px
  box-shadow none
  margin 0

.highlight-container .copy-btn
  align-items center
  background rgba(255, 255, 255, .2)
  border 1px solid rgba(255, 255, 255, .32)
  border-radius 999px
  color #51606a
  display inline-flex
  height 26px
  justify-content center
  opacity .9
  padding 0
  right 12px
  top 9px
  width 26px
  z-index 2

  &:hover
    background rgba(255, 255, 255, .3)
    color #1f2937
    opacity 1

.post-body .highlight
  background transparent
  color #24303d
  line-height 1.78

.post-body .highlight *::selection
  background rgba(0, 113, 227, .16)

.post-body .highlight table
  width 100%

.post-body .highlight figcaption
  align-items center
  background rgba(255, 255, 255, .14)
  border-bottom 1px solid rgba(255, 255, 255, .22)
  color #60707a
  font-size .76rem
  letter-spacing .03em
  padding 10px 16px

.post-body .highlight .gutter
  user-select none

.post-body .highlight .gutter pre
  background rgba(255, 255, 255, .08)
  border-right 1px solid rgba(255, 255, 255, .18)
  color #8f9aa6
  padding 14px 12px 14px 14px
  text-align right

.post-body .highlight .code pre
  background transparent
  color #23303b
  padding 14px 16px
  width 100%

.post-body pre code
  background none
  border 0
  border-radius 0
  box-shadow none
  color #1f2937
  font-size .9rem
  padding 0
  text-shadow none

.post-body pre .comment
  color #8c919b
  font-style italic

.post-body pre .keyword,
.post-body pre .selector-tag,
.post-body pre .meta .keyword,
.post-body pre .doctag
  color #2259bd

.post-body pre .title,
.post-body pre .section,
.post-body pre .function .title,
.post-body pre .class .title
  color #178f92

.post-body pre .string,
.post-body pre .attr,
.post-body pre .template-tag,
.post-body pre .template-variable
  color #966026

.post-body pre .number,
.post-body pre .literal,
.post-body pre .symbol,
.post-body pre .bullet
  color #7854c4

.post-body pre .built_in,
.post-body pre .type,
.post-body pre .params
  color #3d78ad

.post-body pre .variable,
.post-body pre .attribute,
.post-body pre .tag,
.post-body pre .name,
.post-body pre .regexp
  color #b24a52

.post-share
  background linear-gradient(135deg, rgba(255, 255, 255, .32), rgba(241, 246, 249, .2))
  border 1px solid rgba(255, 255, 255, .38)
  border-radius 8px
  box-shadow 0 20px 40px rgba(15, 23, 42, .08)
  backdrop-filter blur(18px)
  margin 36px 0 10px
  padding 22px 22px 18px

.post-share-title
  color #4a575e
  font-size 1rem
  font-weight 700
  margin-bottom 14px

.post-share-actions
  display flex
  flex-wrap wrap
  gap 12px

.post-share-btn
  appearance none
  background rgba(255, 255, 255, .22)
  border 1px solid rgba(255, 255, 255, .34)
  border-radius 999px
  box-shadow 0 10px 20px rgba(15, 23, 42, .06)
  color #334155
  cursor pointer
  font inherit
  font-weight 600
  line-height 1
  padding 12px 18px
  transition transform .18s ease, box-shadow .18s ease, background .18s ease

  &:hover
    background rgba(255, 255, 255, .3)
    box-shadow 0 14px 24px rgba(15, 23, 42, .1)
    transform translateY(-1px)

.post-share-hint
  color #5f6b76
  font-size .92rem
  margin 14px 0 0

.post-share-status
  color #178f92
  font-size .9rem
  font-weight 600
  margin-top 10px

.sidebar
  background transparent
  box-shadow none
  padding 24px 20px

.sidebar-inner
  background linear-gradient(180deg, rgba(255, 255, 255, .24), rgba(241, 246, 249, .16))
  border 1px solid rgba(255, 255, 255, .34)
  border-radius 8px
  box-shadow 0 22px 44px rgba(15, 23, 42, .08)
  backdrop-filter blur(20px)
  color #5a666d
  padding 22px 18px 26px

.site-author
  background linear-gradient(180deg, rgba(255, 255, 255, .22), rgba(244, 247, 250, .14))
  border 1px solid rgba(255, 255, 255, .3)
  border-radius 8px
  box-shadow 0 14px 30px rgba(15, 23, 42, .06)
  backdrop-filter blur(18px)

.site-author
  padding 18px 16px

.site-author
  margin-bottom 16px
  text-align center

.post-toc-wrap .post-toc
  background transparent
  border 0
  border-radius 0
  box-shadow none
  backdrop-filter none
  padding 8px 4px

// Keep the post outline as one surface instead of nesting it inside the sidebar card.
.sidebar-inner:has(.post-toc-wrap)
  background transparent
  border 0
  box-shadow none
  backdrop-filter none
  padding 22px 8px 26px

  .post-toc-wrap .post-toc
    background linear-gradient(180deg, rgba(255, 255, 255, .22), rgba(244, 247, 250, .14))
    border 1px solid rgba(255, 255, 255, .3)
    border-radius 8px
    box-shadow 0 14px 30px rgba(15, 23, 42, .06)
    backdrop-filter blur(18px)
    padding 16px 14px

.site-overview-wrap
  overflow hidden

.site-state-wrap,
.links-of-author,
.links-of-blogroll
  margin-top 16px
  padding 0 6px

.sidebar a,
.site-overview-wrap a
  border-bottom-color rgba(126, 174, 207, .2)
  color #56636a

  &:hover
    border-bottom-color rgba(126, 174, 207, .38)
    color #178f92

.site-author-image
  border 3px solid rgba(255, 255, 255, .54)
  box-shadow 0 14px 30px rgba(15, 23, 42, .12)

.site-author-name,
.site-description,
.links-of-author-item,
.site-state-item-name,
.site-state-item-count,
.sidebar-nav li
  color #56636a

.site-state-item
  padding 0 10px

.sidebar-nav
  background rgba(255, 255, 255, .22)
  border 1px solid rgba(255, 255, 255, .28)
  border-radius 999px
  box-shadow inset 0 1px 0 rgba(255, 255, 255, .2)
  padding 4px

.sidebar-nav li
  border-radius 999px

.sidebar-nav li.sidebar-nav-active
  background rgba(255, 255, 255, .28)
  box-shadow 0 8px 18px rgba(15, 23, 42, .06)

.post-toc .nav
  margin 0

.post-toc .nav-child
  background transparent
  border 0
  box-shadow none

.post-toc .nav .nav-item
  margin 6px 0

.post-toc .nav a
  border-bottom none
  color #5b6872
  display block
  padding 4px 2px
  transition color .18s ease, transform .18s ease

  &:hover
    color #178f92
    transform translateX(2px)

.post-toc .nav .active > a
  color #334155

.back-to-top
  background linear-gradient(135deg, #1f2a44, #178f92)
  border-radius 999px
  box-shadow 0 18px 34px rgba(169, 199, 221, .22)
  color #f8fcfd
  right 26px

.footer
  padding-bottom 28px

.footer-inner
  background rgba(255, 255, 255, .78)
  border 1px solid rgba(213, 218, 227, .82)
  border-radius 8px
  box-shadow 0 12px 28px rgba(15, 23, 42, .04)
  padding 18px 22px

.search-pop-overlay
  background rgba(20, 26, 35, .28)
  backdrop-filter blur(6px)

.search-popup
  background rgba(255, 255, 255, .98)
  border 1px solid rgba(213, 218, 227, .96)
  border-radius 8px
  box-shadow 0 24px 54px rgba(15, 23, 42, .12)

  .search-input-container
    border-bottom 1px solid rgba(213, 218, 227, .96)
    padding 16px 20px

  .search-input
    color #1f2937

  .popup-btn-close
    color #6b7280

    &:hover
      color #178f92

.pagination
  text-align center

  .page-number,
  .extend
    background rgba(247, 249, 251, .95)
    border none
    border-radius 999px
    margin 0 4px
    min-width 40px

  .current
    background linear-gradient(135deg, #1f2a44, #178f92)
    color #f8fcfd

  +mobile()
    padding 18px 14px

.site-meta,
.site-nav,
.site-nav-right,
.site-nav-toggle
  position relative
  z-index 2

.category-all-page
  position relative

  &::before
    color rgba(15, 23, 42, .08)
    content 'KNOWLEDGE MAP'
    font-size .78rem
    font-weight 700
    letter-spacing .32em
    position absolute
    right 2px
    top -14px

  .category-all-title
    align-items center
    background linear-gradient(135deg, rgba(255, 255, 255, .26), rgba(241, 246, 249, .18))
    border 1px solid rgba(255, 255, 255, .34)
    border-radius 999px
    box-shadow 0 18px 36px rgba(15, 23, 42, .08)
    backdrop-filter blur(16px)
    color #4d5a61
    display inline-flex
    font-size .92rem
    font-weight 600
    gap 10px
    letter-spacing .06em
    margin 0 auto
    padding 12px 18px
    text-align center

    &::before
      background linear-gradient(135deg, #1f2a44, #178f92)
      border-radius 50%
      box-shadow 0 0 0 6px rgba(169, 199, 221, .18)
      content ''
      display inline-block
      flex none
      height 8px
      width 8px

  .category-all
    margin-top 26px

  .category-all > .category-list
    display grid
    gap 20px
    grid-template-columns repeat(2, minmax(0, 1fr))

    +mobile()
      gap 16px
      grid-template-columns 1fr

  .category-all > .category-list > .category-list-item
    background linear-gradient(180deg, rgba(255, 255, 255, .28), rgba(241, 246, 249, .18))
    border 1px solid rgba(255, 255, 255, .36)
    border-radius 8px
    box-shadow 0 20px 40px rgba(15, 23, 42, .08)
    backdrop-filter blur(20px)
    margin 0
    padding 20px 22px 18px
    position relative
    transition border-color .22s ease, box-shadow .22s ease, transform .22s ease

    &::before
      background linear-gradient(180deg, #1aa6a8, rgba(26, 166, 168, 0))
      border-radius 999px
      content ''
      height 52px
      left 22px
      position absolute
      top 18px
      width 3px

    &:hover
      border-color rgba(26, 166, 168, .32)
      box-shadow 0 28px 52px rgba(15, 23, 42, .1)
      transform translateY(-3px)

  .category-all > .category-list > .category-list-item > .category-list-link
    color #49565d
    display inline-block
    font-family "Iowan Old Style", "Palatino Linotype", "Noto Serif SC", "Source Han Serif SC", serif
    font-size 1.34rem
    font-weight 600
    letter-spacing .02em
    margin-left 14px
    padding-right 10px

  .category-list
    list-style none
    margin 0
    padding 0

  .category-list-item
    margin 10px 0
    position relative

  .category-list-link
    border-bottom none
    color #1f2937
    transition color .2s ease

    &:hover
      color #178f92

  .category-list-count
    align-items center
    background rgba(255, 255, 255, .2)
    border 1px solid rgba(255, 255, 255, .28)
    border-radius 999px
    color #475569
    display inline-flex
    font-size .78rem
    font-weight 700
    justify-content center
    line-height 1
    margin-left 8px
    min-width 32px
    padding 6px 9px
    vertical-align middle

    &::before
      content none

    &::after
      content none

  .category-list-child
    border-left 1px solid rgba(194, 206, 219, .62)
    margin-left 18px
    margin-top 14px
    padding-left 18px

  .category-list-child > .category-list-item
    margin 12px 0
    padding-left 14px

    &::before
      background linear-gradient(135deg, #1aa6a8, #1f2a44)
      border-radius 50%
      box-shadow 0 0 0 5px rgba(169, 199, 221, .14)
      content ''
      height 7px
      left -22px
      position absolute
      top .72em
      width 7px

  .category-list-child .category-list-link
    font-size .98rem
    font-weight 600

  .category-list-child .category-list-child
    border-left-color rgba(214, 220, 228, .86)
    margin-left 12px
    padding-left 16px

  .category-list-child .category-list-child .category-list-link
    color #475569
    font-size .92rem
    font-weight 500

  +mobile()
    &::before
      font-size .68rem
      right 0
      top -18px

    .category-all-title
      display flex
      justify-content center
      width 100%

    .category-all > .category-list > .category-list-item
      border-radius 8px
      padding 18px 18px 16px

    .category-all > .category-list > .category-list-item > .category-list-link
      font-size 1.18rem
      margin-left 12px

.category-explorer
  border-top 1px solid rgba(126, 174, 207, .24)
  display grid
  grid-template-columns minmax(210px, .62fr) minmax(0, 1.38fr)
  margin-top 28px
  min-height 550px

.category-explorer__catalog
  border-right 1px solid rgba(126, 174, 207, .24)
  padding 22px 22px 22px 0

.category-explorer__catalog-label
  color #178f92
  font-size .7rem
  font-weight 700
  letter-spacing .2em
  margin-bottom 14px

.category-explorer__picker-list
  display flex
  flex-direction column
  gap 3px
  max-height 520px
  overflow-y auto
  padding-right 10px
  scrollbar-color rgba(23, 143, 146, .42) transparent
  scrollbar-width thin

.category-explorer__picker
  align-items center
  background transparent
  border 0
  border-left 2px solid transparent
  color #5b6872
  cursor pointer
  display flex
  font inherit
  gap 12px
  justify-content space-between
  padding 9px 4px 9px 12px
  position relative
  text-align left
  transition background .2s ease, border-color .2s ease, color .2s ease, padding .2s ease
  width 100%

  span
    font-size .96rem
    line-height 1.35

  em
    color #8a98a1
    font-size .72rem
    font-style normal
    font-weight 700

  &:hover
    background rgba(169, 199, 221, .11)
    color #178f92
    padding-left 16px

  &.is-active
    background linear-gradient(90deg, rgba(23, 143, 146, .13), rgba(23, 143, 146, 0))
    border-left-color #178f92
    color #1f2a44
    padding-left 16px

    em
      color #178f92

.category-explorer__detail
  animation category-detail-in .32s ease both
  padding 28px 0 30px 42px

.category-explorer__detail-heading
  border-bottom 1px solid rgba(126, 174, 207, .24)
  margin-bottom 22px
  padding-bottom 18px

  span
    color #178f92
    font-size .72rem
    font-weight 700
    letter-spacing .14em

  h2
    color #273844
    font-family "Iowan Old Style", "Palatino Linotype", "Noto Serif SC", "Source Han Serif SC", serif
    font-size 2rem
    line-height 1.2
    margin 7px 0 6px

  p
    color #7b8790
    font-size .9rem
    margin 0

.category-explorer__tree,
.category-explorer__articles
  list-style none
  margin 0
  padding 0

.category-explorer__tree--root
  animation category-tree-in .4s ease both

.category-explorer__branch
  position relative

.category-explorer__branch-head
  align-items center
  display flex
  gap 8px
  min-height 33px

.category-explorer__branch-toggle,
.category-explorer__branch-dot
  align-items center
  background transparent
  border 0
  display inline-flex
  flex 0 0 20px
  height 20px
  justify-content center
  padding 0
  width 20px

.category-explorer__branch-toggle
  cursor pointer

  i
    border-bottom 1px solid #7d909d
    border-right 1px solid #7d909d
    height 6px
    transform rotate(-45deg)
    transition transform .2s ease
    width 6px

.category-explorer__branch.is-open > .category-explorer__branch-head .category-explorer__branch-toggle i
  transform rotate(45deg) translate(-2px, -2px)

.category-explorer__branch-dot::after
  background #9dbec5
  border-radius 50%
  content ''
  height 5px
  width 5px

.category-explorer__branch-link
  border-bottom 0
  color #40515d
  font-size .98rem
  font-weight 600

  &:hover
    color #178f92

.category-explorer__branch-count
  color #91a0a8
  font-size .72rem
  font-weight 700
  margin-left 2px

.category-explorer__branch-body
  display grid
  grid-template-rows 0fr
  margin-left 10px
  transition grid-template-rows .28s ease

  > div
    min-height 0
    overflow hidden

.category-explorer__branch.is-open > .category-explorer__branch-body
  grid-template-rows 1fr

.category-explorer__branch-body .category-explorer__tree,
.category-explorer__articles
  border-left 1px solid rgba(126, 174, 207, .28)
  margin-left 10px
  padding-left 15px

.category-explorer__articles
  margin-bottom 8px

.category-explorer__article
  line-height 1.45
  margin 6px 0
  position relative

  &::before
    background #9dbec5
    border-radius 50%
    content ''
    height 4px
    left -18px
    position absolute
    top .55em
    width 4px

  a
    border-bottom 0
    color #667682
    font-size .9rem

    &:hover
      color #178f92

.category-explorer__empty
  color #7b8790
  margin-top 28px

@keyframes category-detail-in
  from
    opacity 0
    transform translateY(8px)
  to
    opacity 1
    transform translateY(0)

@keyframes category-tree-in
  from
    opacity 0
    transform translateX(-8px)
  to
    opacity 1
    transform translateX(0)

+mobile()
  .category-explorer
    display block
    min-height 0

  .category-explorer__catalog
    border-bottom 1px solid rgba(126, 174, 207, .24)
    border-right 0
    padding 20px 0

  .category-explorer__picker-list
    max-height 250px
    padding-right 4px

  .category-explorer__detail
    padding 24px 0

  .category-explorer__detail-heading h2
    font-size 1.65rem

#blog-ai-agent-root
  position fixed
  right 24px
  bottom 28px
  z-index 40

  +mobile()
    right 14px
    bottom 18px

.blog-ai-agent__toggle
  background linear-gradient(135deg, #1f2a44, #178f92)
  border none
  border-radius 999px
  box-shadow 0 18px 36px rgba(23, 143, 146, .22)
  color #f8fbff
  cursor pointer
  font-size .95rem
  font-weight 600
  letter-spacing .02em
  padding 14px 18px

.blog-ai-agent__panel
  background rgba(250, 253, 254, .94)
  border 1px solid rgba(255, 255, 255, .72)
  border-radius 8px
  box-shadow 0 26px 60px rgba(15, 23, 42, .14)
  display none
  margin-top 14px
  max-width 92vw
  overflow hidden
  width 420px

  &.is-open
    display block

  +mobile()
    width 92vw

.blog-ai-agent__header
  align-items flex-start
  background linear-gradient(135deg, rgba(31, 42, 68, .94), rgba(23, 143, 146, .82))
  border-bottom 1px solid rgba(255, 255, 255, .28)
  display flex
  justify-content space-between
  gap 12px
  padding 18px 18px 14px

  h3
    color #f8fcfd
    font-size 1rem
    margin 0

  p
    color rgba(248, 252, 253, .72)
    font-size .8rem
    line-height 1.45
    margin 6px 0 0

.blog-ai-agent__close
  background transparent
  border none
  color rgba(248, 252, 253, .82)
  cursor pointer
  font-size 1.4rem
  line-height 1
  padding 2px 4px

.blog-ai-agent__suggestions
  display flex
  flex-wrap wrap
  gap 8px
  padding 14px 18px 0

  button
    background rgba(238, 248, 249, .92)
    border 1px solid rgba(23, 143, 146, .18)
    border-radius 999px
    color #243447
    cursor pointer
    font-size .8rem
    padding 8px 12px

.blog-ai-agent__messages
  max-height 360px
  overflow auto
  padding 14px 18px

.blog-ai-agent__message
  border-radius 8px
  margin-bottom 12px
  padding 12px 14px

.blog-ai-agent__message--assistant
  background #f5fafb
  border 1px solid rgba(205, 226, 230, .92)

.blog-ai-agent__message--user
  background linear-gradient(135deg, #1f2a44, #178f92)
  color #f8fbff
  margin-left 24px

.blog-ai-agent__message-label
  font-size .74rem
  font-weight 700
  letter-spacing .05em
  margin-bottom 6px
  opacity .72
  text-transform uppercase

.blog-ai-agent__message-body
  font-size .92rem
  line-height 1.65
  white-space pre-wrap
  word-break break-word

.blog-ai-agent__citation-list
  display grid
  gap 8px
  margin-top 12px

.blog-ai-agent__citation
  background rgba(255, 255, 255, .9)
  border 1px solid rgba(205, 226, 230, .95)
  border-radius 8px
  color #334155
  display grid
  gap 4px
  padding 10px 12px
  text-decoration none

  strong
    color #1e293b
    font-size .84rem

  span
    color #607080
    font-size .78rem
    line-height 1.45

.blog-ai-agent__related
  display flex
  flex-wrap wrap
  gap 8px
  margin-top 12px

.blog-ai-agent__related-link
  background #eef8f9
  border 1px solid rgba(23, 143, 146, .18)
  border-radius 999px
  color #178f92
  font-size .78rem
  padding 7px 11px
  text-decoration none

.blog-ai-agent__form
  border-top 1px solid rgba(214, 223, 232, .9)
  display grid
  gap 10px
  padding 16px 18px 18px

.blog-ai-agent__input
  background #fff
  border 1px solid rgba(205, 226, 230, .95)
  border-radius 8px
  color #243341
  font inherit
  min-height 88px
  outline none
  padding 12px 14px
  resize vertical

.blog-ai-agent__submit
  background linear-gradient(135deg, #1f2a44, #178f92)
  border none
  border-radius 999px
  color #f8fbff
  cursor pointer
  font-size .9rem
  font-weight 600
  justify-self end
  padding 10px 16px

.blog-ai-agent__header-actions
  align-items center
  display flex
  flex-shrink 0
  gap 6px

.blog-ai-agent__new-conversation
  background rgba(248, 252, 253, .12)
  border 1px solid rgba(248, 252, 253, .28)
  border-radius 999px
  color rgba(248, 252, 253, .9)
  cursor pointer
  font-size .72rem
  line-height 1
  padding 7px 10px

  &:hover
    background rgba(248, 252, 253, .2)
    color #fff

.blog-ai-agent__suggestions button:disabled
  cursor wait
  opacity .58

.blog-ai-agent__messages[aria-busy='true']
  cursor progress

.blog-ai-agent__claim
  margin 0 0 8px

  &:last-child
    margin-bottom 0

.blog-ai-agent__claim-citation
  color #178f92
  font-size .78rem
  font-weight 700
  text-decoration none

.blog-ai-agent__feedback
  align-items center
  border-top 1px solid rgba(205, 226, 230, .8)
  display flex
  flex-wrap wrap
  gap 7px
  margin-top 12px
  padding-top 10px

.blog-ai-agent__feedback-question,
.blog-ai-agent__feedback-status,
.blog-ai-agent__feedback-reason-label
  color #607080
  font-size .72rem

.blog-ai-agent__feedback-actions
  display flex
  gap 6px

  button
    background #fff
    border 1px solid rgba(23, 143, 146, .25)
    border-radius 999px
    color #178f92
    cursor pointer
    font-size .72rem
    padding 4px 8px

    &:disabled
      cursor default
      opacity .55

.blog-ai-agent__feedback-reason-label
  align-items center
  display flex
  gap 4px

.blog-ai-agent__feedback-reason
  background #fff
  border 1px solid rgba(205, 226, 230, .95)
  border-radius 5px
  color #475569
  font-size .72rem
  max-width 112px
  padding 3px 4px

.blog-ai-agent__feedback-status
  flex-basis 100%

.blog-ai-agent__feedback.is-submitted .blog-ai-agent__feedback-reason-label
  display none
